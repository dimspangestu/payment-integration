# ============================================================
#  DANA QRIS Dashboard — environment variables
#  Copy ke .env.local (lokal) atau isi di Vercel > Settings > Environment Variables
# ============================================================

# sandbox | production
DANA_ENV=sandbox
# Opsional: override base URL (default sandbox: https://api.sandbox.dana.id)
# DANA_BASE_URL=https://api.sandbox.dana.id

# X-PARTNER-ID (clientId dari DANA)
DANA_PARTNER_ID=
# Merchant ID
DANA_MERCHANT_ID=
# CHANNEL-ID header (default DANA: 95221)
DANA_CHANNEL_ID=95221
# ORIGIN header (domain anda)
DANA_ORIGIN=

# Private key merchant (RSA). Boleh multiline PEM, satu baris dengan \n,
# atau base64 polos tanpa header -----BEGIN-----
DANA_PRIVATE_KEY=

# Public key DANA untuk verifikasi webhook.
# Kalau DANA_ENV=sandbox dan ini kosong, otomatis pakai sandbox public key DANA.
DANA_PUBLIC_KEY=

# ---------- Default QRIS ----------
# Default storeId untuk MPM (bisa diganti di form)
DANA_STORE_ID=
# externalStoreId untuk CPM
DANA_EXTERNAL_STORE_ID=
# CPM additionalInfo
DANA_CPM_PRODUCT_CODE=51051000100000000040
DANA_CPM_MCC=5732
DANA_CPM_TITLE=QRIS CPM Payment
DANA_CPM_DEVICE_ID=WEB-DASHBOARD
# Opsional: notifyUrl yang dikirim di request CPM
DANA_NOTIFY_URL=

# ---------- Refund ----------
DANA_REFUND_ACTOR_ID=DASHBOARD
DANA_REFUND_ACTOR_TYPE=BACK_OFFICE
# Opsional: kalau diisi, request refund menyertakan refundOptionBill [{payMethod, transAmount}]
# DANA_REFUND_PAY_METHOD=BALANCE

# ---------- Webhook ----------
# Path yang dipakai DANA saat sign notify (sesuai notify URL yang didaftarkan)
DANA_WEBHOOK_PATH=/v1.0/debit/notify
# JANGAN true di production. Hanya untuk debug: terima webhook walau signature gagal.
DANA_WEBHOOK_SKIP_VERIFY=false

# Tampilkan stringToSign di response API dashboard (sandbox only)
DANA_DEBUG=true

# ---------- Storage webhook (wajib untuk Vercel) ----------
# Upstash Redis / Vercel KV (Marketplace > Upstash). Salah satu pasangan ini:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------- Proteksi dashboard (Basic Auth) ----------
# Sangat disarankan di Vercel, karena endpoint cancel/refund bisa dipanggil siapa saja
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
